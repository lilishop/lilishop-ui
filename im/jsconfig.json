{
  // ==============================================================================
  // JavaScript 项目语言服务配置文件 (jsconfig.json)
  // 用于指导 VS Code 等 IDE 进行代码跳转、智能提示和路径别名映射解析
  // ==============================================================================
  "compilerOptions": {
    // 指定编译后的 JavaScript 目标语言版本
    "target": "es6",
    // 解析非相对模块名称的基准目录（当前根目录）
    "baseUrl": ".",
    // 配置模块名到基于 baseUrl 的路径映射（与 vue.config.js 中的 webpack alias 保持一致）
    "paths": {
      // 将 @/* 映射至 src/*，以便在编辑器中编写 import ... from '@/...' 时支持快捷跳转
      "@/*": [
        "src/*"
      ]
    }
  },
  // 排除在代码智能索引和语法检查之外的目录
  "exclude": [
    "node_modules",
    "dist"
  ],
  // 包含在智能提示与类型检查范围内的源文件匹配规则
  "include": [
    "src/**/*"
  ]
}
