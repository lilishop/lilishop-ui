# ==============================================================================
# lilishop-im 本地开发环境配置文件
# 执行 npm run serve 启动本地开发服务时，会优先加载此文件并覆盖 .env 中的同名变量
# 注意：以 VUE_APP_ 开头的变量会被 webpack.DefinePlugin 静态嵌入客户端代码中
# 变量修改后需要重新启动开发服务方可生效
#
# 【重要提示】
# 1. 本地联调如果使用本地或局域网服务（如 127.0.0.1 / localhost），WebSocket 必须使用 ws:// 协议！
#    例如: ws://127.0.0.1:8885/lili/webSocket
#    切勿在无 SSL 证书的本地环境下使用 wss://，否则会导致 WebSocket 握手失败、聊天无法连通！
# 2. 只有在线上域名并配置了 SSL/HTTPS 证书的情况下才使用 wss:// 协议。
# ==============================================================================

# 当前运行环境模式：development (本地开发环境)
NODE_ENV=development

# 是否开启预览模式 (true: 开启, false: 关闭)
VUE_APP_PREVIEW=false

# IM 服务的 HTTP 接口请求基准地址
# 线上演示示例: https://im-api.pickmall.cn
# 本地联调示例: http://127.0.0.1:8885
VUE_APP_API_BASE_URL=https://im-api.pickmall.cn

# IM 服务的 WebSocket 实时通讯地址
# 【重要提示】本地联调未配置 SSL 证书时务必使用 ws:// 协议，切勿写成 wss://！
# 本地联调推荐配置: ws://127.0.0.1:8885/lili/webSocket
# 线上已配置证书时: wss://im-api.pickmall.cn/lili/webSocket
VUE_APP_WEB_SOCKET_URL=wss://im-api.pickmall.cn/lili/webSocket

# 买家端业务接口基准地址 (本地联调示例: http://127.0.0.1:8888)
VUE_APP_BUYER=https://buyer-api.pickmall.cn

# 商家端业务接口基准地址 (本地联调示例: http://127.0.0.1:8889)
VUE_APP_SELLER=https://admin-api.pickmall.cn

# IM 网站/系统标题名称 (显示在浏览器标题栏与系统头部)
VUE_APP_WEBSITE_NAME="LiLi IM"

# PC 端商城前台首页及商品详情跳转前缀地址 (点击聊天中的商品卡片时跳转)
VUE_APP_PC_URL=https://pc-b2b2c.pickmall.cn/

# PC 端商家管理后台跳转前缀地址 (点击聊天中的订单信息时跳转商家端订单页面)
VUE_APP_PC_STORE=https://store-b2b2c.pickmall.cn/
