# ==============================================================================
# lilishop-im 生产环境默认环境变量配置
# 执行 npm run build 进行生产打包时，默认会加载此文件中的环境变量
# 注意：以 VUE_APP_ 开头的变量会被 webpack.DefinePlugin 静态嵌入客户端代码中
# 变量修改后需要重新构建/运行项目方可生效
#
# 【协议提示】
# - 线上生产环境配置了 SSL/HTTPS 证书时，WebSocket 使用 wss:// 协议
# - 本地开发环境未配置 SSL 证书时，WebSocket 必须使用 ws:// 协议，否则会连接失败
# ==============================================================================

# 当前运行环境模式：production (生产环境)
NODE_ENV=production

# 是否开启预览模式 (true: 开启, false: 关闭)
VUE_APP_PREVIEW=false

# IM 服务的 HTTP 接口请求基准地址 (用于登录认证、好友、群组、聊天记录查询等)
VUE_APP_API_BASE_URL=https://im-api.pickmall.cn

# IM 服务的 WebSocket 实时通讯地址 (支持 ws:// 或 wss://，生产环境已配置 SSL 证书使用 wss://；本地无证书环境必须使用 ws://)
VUE_APP_WEB_SOCKET_URL=wss://im-api.pickmall.cn/lili/webSocket

# 买家端业务接口基准地址 (用于获取买家用户信息、商品信息、订单信息等)
VUE_APP_BUYER=https://buyer-api.pickmall.cn

# 商家端业务接口基准地址 (用于获取店铺资料、商家客服相关信息等)
VUE_APP_SELLER=https://admin-api.pickmall.cn

# IM 网站/系统标题名称 (显示在浏览器标题栏与系统头部)
VUE_APP_WEBSITE_NAME="LiLi IM"

# PC 端商城前台首页及商品详情跳转前缀地址 (点击聊天中的商品卡片时跳转)
VUE_APP_PC_URL=https://pc-b2b2c.pickmall.cn/

# PC 端商家管理后台跳转前缀地址 (点击聊天中的订单信息时跳转商家端订单页面)
VUE_APP_PC_STORE=https://store-b2b2c.pickmall.cn/
